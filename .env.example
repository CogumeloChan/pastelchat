# Produção
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pastelchat
DATABASE_SSL=true
JWT_SECRET=COLOQUE_AQUI_UMA_CHAVE_LONGA_E_ALEATORIA
FRONTEND_ORIGIN=https://SEU-DOMINIO.com

# TURN é necessário para melhorar chamadas WebRTC em redes restritas.
# No frontend, substitua o STUN por seus dados TURN:
# turns:turn.seu-dominio.com:5349

# Opcional, mas recomendado para chamadas funcionarem entre redes/NATs mais restritivos
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
